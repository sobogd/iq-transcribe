generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transcription {
  id         String   @id @default(cuid())
  ownerKey   String? // "telegram:<id>" | "device:<uuid>"
  title      String   @default("")
  fileName   String
  fileUrl    String? // S3 url of the original uploaded file (best-effort)
  mimeType   String   @default("")
  sizeBytes  Int? // original file size in bytes
  language   String   @default("") // detected spoken language, e.g. "ru" | "es" | "en"
  transcript String   @default("")
  summary    String   @default("")
  createdAt  DateTime @default(now())

  @@index([ownerKey])
  @@map("transcriptions")
}
